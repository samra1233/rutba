# RUBTA COUTURE ENVIRONMENT CONFIGURATION

# Server Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=your_admin_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_strong_password_here

# Payment Gateway Keys (Server-only secret key, never expose in VITE_*)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Frontend Environment Variables (Exposed to browser via Vite)
VITE_API_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
