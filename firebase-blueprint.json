{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents an e-commerce product suit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "fabric": { "type": "string" },
        "type": { "type": "string" },
        "collection": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "stock": { "type": "number" },
        "colors": { "type": "array" },
        "viewers": { "type": "number" },
        "isNewArrival": { "type": "boolean" },
        "features": { "type": "array" },
        "category": { "type": "string" },
        "pieces": { "type": "string" },
        "season": { "type": "string" },
        "sizes": { "type": "array" },
        "isBestSeller": { "type": "boolean" },
        "onSale": { "type": "boolean" },
        "salePrice": { "type": "number" }
      },
      "required": ["id", "name", "price", "fabric", "type", "collection", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "shippingDetails": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "paymentDetails": { "type": "object" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "trackingNumber", "userId", "items", "shippingDetails", "subtotal", "shippingCost", "total", "status", "createdAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "A user's shopping cart items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["userId", "items"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin credentials for dashboard operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" }
      },
      "required": ["id", "email", "passwordHash"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global shop settings and announcements",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string" },
        "homeMarqueeText": { "type": "string" },
        "shippingFee": { "type": "number" },
        "freeShippingThreshold": { "type": "number" }
      },
      "required": ["announcementText", "homeMarqueeText"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product inventory"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders and status tracking"
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User carts synced to the cloud"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin access list"
    },
    "/settings/global": {
      "schema": "Settings",
      "description": "Global configuration document"
    }
  }
}
